generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model EmailVerification {
  id           String   @id @default(uuid())
  email        String
  code         String
  passwordHash String
  role         UserRole @default(USER)
  createdAt    DateTime @default(now())
  expiresAt    DateTime
  attempts     Int      @default(0)
  lastSentAt   DateTime @default(now())

  @@index([email])
}

model PhoneNumberVerification {
  userId      String
  id          String   @id @default(uuid())
  phoneNumber String
  code        String
  createdAt   DateTime @default(now())
  expiresAt   DateTime
  attempts    Int      @default(0)
  lastSentAt  DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([phoneNumber])
}

model PasswordReset {
  id         String   @id @default(cuid())
  email      String
  code       String
  attempts   Int
  expiresAt  DateTime
  lastSentAt DateTime
}

model User {
  id                 String                    @id @default(uuid())
  email              String                    @unique
  hash               String
  Firstname          String?
  Lastname           String?
  phone              String?
  role               UserRole                  @default(USER)
  createdAt          DateTime                  @default(now())
  updatedAt          DateTime                  @updatedAt
  Screenname         String?                   @unique
  bookings           Booking[]
  favorites          Favorite[]
  payments           Payment[]
  rentals            Rental[]
  tourRequests       TourRequest[]
  appliesRequested   appliesRequested[] // FIXED: this is now many []
  enscrolls          enscroll[]
  verified           Boolean                   @default(false)
  phoneNumber        String?
  hotelName          String?
  hotelAddress       String?
  hotelLocation      String?
  hotelCoords        Json?
  phoneVerifications PhoneNumberVerification[]
  properties         Property[]
  pushSubscriptions  PushSubscription[]
  staffAccounts      ManagementStaff[]         @relation("AgentToStaff")
}

model PushSubscription {
  id        String   @id @default(uuid())
  userId    String
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model appliesRequested {
  id          String   @id @default(uuid())
  userId      String
  propertyId  String
  requestedAt DateTime @default(now())
  status      String   @default("PENDING")
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  property    Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@unique([userId, propertyId])
}

model Property {
  id               String             @id @default(uuid())
  title            String
  description      String?
  type             PropertyType
  address          String
  images           String[]
  beds             Int
  typerooms        String
  baths            Int
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  coords           Json?
  location         String
  offers           String
  price            Json
  amenities        Amenity[]
  bookings         Booking[]
  favoritedBy      Favorite[]
  rentals          Rental[]
  tourRequests     TourRequest[]
  appliesRequested appliesRequested[]
  shortlet         Shortlet?
  userId           String?
  user             User?              @relation(fields: [userId], references: [id])
  hotelRooms       HotelRoom[]
}

model TourRequest {
  id          String   @id @default(uuid())
  userId      String
  propertyId  String
  requestedAt DateTime @default(now())
  status      String   @default("PENDING")
  property    Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Favorite {
  id         String   @id @default(uuid())
  userId     String
  propertyId String
  createdAt  DateTime @default(now())
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, propertyId])
}

model Amenity {
  id         String   @id @default(uuid())
  name       String   @unique
  propertyId String
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
}

model Booking {
  id         String        @id @default(uuid())
  userId     String
  propertyId String
  startDate  DateTime
  endDate    DateTime
  status     BookingStatus @default(PENDING)
  notes      String?
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt
  property   Property      @relation(fields: [propertyId], references: [id])
  user       User          @relation(fields: [userId], references: [id])
  payments   Payment[]

  isWalkIn          Boolean @default(false)
  processedByStaffId String?
  staff             ManagementStaff? @relation("StaffToBooking", fields: [processedByStaffId], references: [id])
  hotelRoomId       String?
  hotelRoom         HotelRoom? @relation("RoomToBooking", fields: [hotelRoomId], references: [id])
}

model enscroll {
  id         String   @id @default(uuid())
  userId     String
  status     String   @default("Available")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  user       User     @relation(fields: [userId], references: [id])
  address    String
  HostelName String
  price      Int
  decription String
}

model Shortlet {
  id          String       @id @default(uuid())
  propertyId  String       @unique
  property    Property     @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  roomOptions RoomOption[]
  images      String[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

model RoomOption {
  id          String   @id @default(uuid())
  shortletId  String
  shortlet    Shortlet @relation(fields: [shortletId], references: [id], onDelete: Cascade)
  name        String
  beds        Int
  price       Int
  description String
  amenities   String[]
  images      String[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([shortletId])
}

model Rental {
  id         String       @id @default(uuid())
  userId     String
  propertyId String
  startDate  DateTime
  endDate    DateTime?
  status     RentalStatus @default(ACTIVE)
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt
  payments   Payment[]
  property   Property     @relation(fields: [propertyId], references: [id])
  user       User         @relation(fields: [userId], references: [id])
}

model Payment {
  id        String        @id @default(uuid())
  userId    String
  bookingId String?
  rentalId  String?
  amount    Int
  status    PaymentStatus @default(PENDING)
  reference String
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  booking   Booking?      @relation(fields: [bookingId], references: [id])
  rental    Rental?       @relation(fields: [rentalId], references: [id])
  user      User          @relation(fields: [userId], references: [id])
}

enum UserRole {
  USER
  AGENT
  ADMIN
}

enum PropertyType {
  APARTMENT
  ShortLET
  Hostels
  HOTEL_ROOM
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
}

enum RentalStatus {
  ACTIVE
  COMPLETED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
}

model ManagementStaff {
  id        String   @id @default(uuid())
  agentId   String
  agent     User     @relation("AgentToStaff", fields: [agentId], references: [id])
  name      String
  username  String   @unique
  password  String
  role      StaffRole @default(RECEPTIONIST)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  bookings  Booking[] @relation("StaffToBooking")
}

enum StaffRole {
  MANAGER
  RECEPTIONIST
}

model HotelRoom {
  id          String   @id @default(uuid())
  propertyId  String
  property    Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  roomNumber  String
  roomName    String?
  category    String   // Standard, Deluxe, etc.
  floor       String?
  price       Int
  description String?
  amenities   String?
  status      RoomStatus @default(AVAILABLE)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  bookings    Booking[] @relation("RoomToBooking")
}

enum RoomStatus {
  AVAILABLE
  OCCUPIED
  MAINTENANCE
}
